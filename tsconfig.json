{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@shareflow/shared": [
        "../../packages/shared/src"
      ],
      "@shareflow/ui-tokens": [
        "../../packages/ui-tokens/src"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
